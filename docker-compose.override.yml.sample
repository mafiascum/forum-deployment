services:
    database:
        build: ./database
        platform: linux/arm64
        restart: always
        ports:
            - "127.0.0.1:3306:3306"
        env_file:
            - .env
        volumes:
            - mariadb_data:/var/lib/mysql
        networks:
            backend:
                ipv4_address: 172.40.0.10
    nginx:
        image: nginx
        ports:
            - 80:80
            - 443:443
        depends_on:
            - web
        env_file:
            - .env
        volumes:
            - ./nginx-dev/nginx.conf:/etc/nginx/nginx.conf
            - ./nginx-dev/cert:/etc/nginx/certs
            - ./nginx-dev/sites:/etc/nginx/templates
        networks:
            backend:
                ipv4_address: 172.40.0.2
    web:
        build: 
            context: ./web
            args:
                PHP_INI_DEVELOPMENT: true
        restart: always
        depends_on:
            - database
        env_file:
            - .env
        volumes:
            - wiki_data:/data/wiki
            - phpbb_data:/data/forum
            - access_logs:/etc/apache2/logs
            - ./web/apache/httpd.conf:/etc/apache2/conf-enabled/httpd.conf
            - ./web/apache/usertrack.conf:/etc/apache2/conf-enabled/usertrack.conf
            - ./web/apache/remoteip.conf:/etc/apache2/conf-enabled/remoteip.conf
            - ./web/extensions:/mafiascum/extensions
            - ./web/styles:/mafiascum/styles
        networks:
            backend:
                ipv4_address: 172.40.0.11

    web-alt:
        build: 
            context: ./web
            args:
                PHP_INI_DEVELOPMENT: true
        restart: no
        depends_on:
            - database
        env_file:
            - .env
        volumes:
            - wiki_data:/data/wiki
            - phpbb_data:/data/forum
            - access_logs:/etc/apache2/logs
            - ./web/apache/httpd.conf:/etc/apache2/conf-enabled/httpd.conf
            - ./web/apache/usertrack.conf:/etc/apache2/conf-enabled/usertrack.conf
            - ./web/apache/remoteip.conf:/etc/apache2/conf-enabled/remoteip.conf
            - ./web/extensions:/mafiascum/extensions
            - ./web/styles:/mafiascum/styles
        networks:
            backend:
                ipv4_address: 172.40.0.12
    ftp:
        image: atmoz/sftp
        env_file:
            - .env
        volumes:
            - phpbb_data:/home/ftp_user/phpbb
        ports:
            - "2222:22"
        command: "ftp_user:pass:1010:0"
    
    sphinx:
        build: ./sphinx
        platform: linux/arm64
        restart: always
        depends_on:
        - database
        env_file:
        - .env
        volumes:
        - sphinx_data:/var/lib/sphinxsearch/data
        - ./sphinx/config/sphinx.conf:/etc/sphinxsearch/sphinx.conf.template
        - ./sphinx/cron.d:/etc/cron.d.template
        networks:
        backend:
            ipv4_address: 172.40.0.14